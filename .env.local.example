# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used by admin actions, the sign-in rate limit and the
# db:cleanse / db:seed scripts. Never expose it to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Signs the employee session cookie (lib/auth/session.ts). Set a long random
# string in production. If empty, the service role key is used instead.
EMPLOYEE_SESSION_SECRET=

# PayMongo (PP1, GitHub #9). The browser creates the wallet payment method
# and attaches it to the intent, so it needs the PUBLIC key only. The secret
# key and webhook secret live in Supabase Function secrets, never here —
# see supabase/functions/create-payment-intent/index.ts.
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=

# Optional. The "your order was cancelled" email (lib/email/send-email.ts),
# sent through Resend (free tier). Leave empty and no email is sent; the
# in-app notification still is. Until you verify a domain in Resend, use
# onboarding@resend.dev as the sender (it only delivers to your own address).
RESEND_API_KEY=
EMAIL_FROM=

# Optional. The restaurant's location for delivery distance and fees.
# Leave commented out to use the default (Manila). An empty value breaks it.
# RESTAURANT_LAT=14.5694
# RESTAURANT_LNG=120.9856

# Optional. Password for the demo accounts db:seed creates.
# Defaults to YangsDemo2026!
SEED_PASSWORD=
