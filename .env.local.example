# Supabase project settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Only needed once server-side admin actions exist (e.g. admin panel, phase 2)
SUPABASE_SERVICE_ROLE_KEY=

# PayMongo (PP1, GitHub #9). The browser creates the wallet payment method
# and attaches it to the intent, so it needs the PUBLIC key only. The secret
# key and webhook secret live in Supabase Function secrets, never here —
# see supabase/functions/create-payment-intent/index.ts.
NEXT_PUBLIC_PAYMONGO_PUBLIC_KEY=
